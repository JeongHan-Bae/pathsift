{
  "name": "pathsift",
  "version": "0.1.0",
  "description": "Inspect, copy, and archive directory trees with Git-style ignore rules",
  "keywords": [
    "cli",
    "filesystem",
    "tree",
    "gitignore",
    "archive"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "pathsift": "./dist/boot/cli-main.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:tdd": "npm run build && node scripts/run-tdd.mjs",
    "test:source": "npm run build && node scripts/run-bdd.mjs source",
    "test:compiled": "npm run build && node scripts/run-bdd.mjs compiled",
    "test:package": "npm run build && node scripts/run-package-tests.mjs",
    "test:bdd": "npm run test:compiled",
    "test": "npm run test:tdd && npm run test:source && npm run test:compiled",
    "check:dependencies": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=moderate",
    "verify:release": "npm run check:static && npm test && npm run test:package && npm run check:dependencies && npm run check:package && npm run stage:release",
    "verify:precommit": "npm run verify:release && git diff --check && git diff --cached --check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify:release",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:platform": "node scripts/check-platform-neutral.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:static": "npm run typecheck && npm run check:syntax && npm run check:platform && npm run check:boundaries",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "stage:release": "npm run build && node scripts/stage-release.mjs"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "ignore": "^7.0.0",
    "ink": "5.2.1",
    "react": "18.3.1"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/hash.md",
    "pathsift.config.json",
    "global.ignore"
  ],
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "22.10.0",
    "@types/react": "18.3.18",
    "node-pty": "^1.1.0",
    "tar": "7.5.22",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
